# ---- Core ----
APP_NAME=SAHAYATA
ENVIRONMENT=dev                      # dev | production
SECRET_KEY=change-me-to-a-long-random-string

# ---- Database (default: local SQLite dev file) ----
# DATABASE_URL=postgresql+psycopg://sahayata:sahayata@localhost:5432/sahayata

# ---- Security ----
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- HTTP ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=10/minute

# ---- Storage (uploads) ----
STORAGE_DRIVER=local                 # local | s3
PUBLIC_BASE_URL=
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- AI (all optional; platform degrades gracefully without them) ----
AI_TEXT_ENABLED=true                 # local TF-IDF classifier, offline
AI_VISION_PROVIDER=none              # none | openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-4o-mini
ENABLE_LOCAL_STT=false               # requires faster-whisper installed separately

# ---- Geo / clustering ----
DEFAULT_CENTER_LAT=23.3441           # Ranchi demo region
DEFAULT_CENTER_LNG=85.3096
CLUSTER_RADIUS_M_DEFAULT=150
CLUSTER_TEXT_SIMILARITY_THRESHOLD=0.62
CLUSTER_TIME_WINDOW_DAYS=30
PUBLIC_COORD_JITTER_M=150            # privacy fuzzing for public views

# ---- Bootstrap admin (password printed once on first seed if left empty) ----
ADMIN_EMAIL=admin@sahayata.gov.in
ADMIN_PASSWORD=
